# Internal Umami address; /api is optional. localhost means THIS container.
# Same Docker network: http://umami:3000; other VM: private VM hostname/IP.
UMAMI_URL=
# Server-side only. Do not use a VITE_ prefix or commit the real .env.
UMAMI_API_KEY=
# false for real data. Demo must be explicitly enabled.
DEMO_MODE=false
# Docker host port; local development uses web 18471 and API 18472.
DASHBOARD_PORT=18470

# For build/push and production pulls. Example: ghcr.io/your-account
IMAGE_REGISTRY=
IMAGE_TAG=0.1.0
# Optional additional build/push tags, comma-separated. Not used by Compose.
IMAGE_EXTRA_TAGS=latest
IMAGE_PLATFORMS=linux/amd64,linux/arm64
# Source label for Docker images; change this when publishing from your own fork.
IMAGE_SOURCE=https://github.com/jpligthart/UmamiDashboard
# Optional labels for local compose builds; docker:push computes these.
# IMAGE_REVISION=
# IMAGE_CREATED=
